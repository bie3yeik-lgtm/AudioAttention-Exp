@@ -0,0 +1,281 @@
+name: Budgeted Unified GPU Job
+
+on:
+  workflow_dispatch:
+    inputs:
+      job_spec_path:
+        required: true
+        default: examples/job-spec.teacher.json
+      units:
+        required: true
+        default: "1"
+      prediction_source:
+        type: choice
+        required: true
+        default: auto
+        options: [auto, historical, contextual]
+      bandit_mode:
+        type: choice
+        required: true
+        default: shadow
+        options: [advisory, shadow, active]
+
+permissions:
+  contents: read
+  packages: read
+
+jobs:
+  route:
+    runs-on: ubuntu-latest
+    outputs:
+      job_id: ${{ steps.route.outputs.job_id }}
+      workload: ${{ steps.route.outputs.workload }}
+      provider: ${{ steps.route.outputs.provider }}
+      gpu_id: ${{ steps.route.outputs.gpu_id }}
+      offer_id: ${{ steps.route.outputs.offer_id }}
+      price: ${{ steps.route.outputs.price }}
+      reserve_amount: ${{ steps.route.outputs.reserve_amount }}
+      hf_bucket: ${{ steps.route.outputs.hf_bucket }}
+      image: ${{ steps.route.outputs.image }}
+      command: ${{ steps.route.outputs.command }}
+      hf_namespace: ${{ steps.route.outputs.hf_namespace }}
+    env:
+      HF_TOKEN: ${{ secrets.HF_TOKEN }}
+      HF_BUCKET: ${{ vars.HF_BUCKET }}
+      VAST_API_KEY: ${{ secrets.VAST_API_KEY }}
+      RUNPOD_API_KEY: ${{ secrets.RUNPOD_API_KEY }}
+      VAST_TEACHER_GPU_QUERY: ${{ vars.VAST_TEACHER_GPU_QUERY }}
+      VAST_TEACHER_MAX_DPH: ${{ vars.VAST_TEACHER_MAX_DPH }}
+      VAST_TEACHER_DISK_GB: ${{ vars.VAST_TEACHER_DISK_GB }}
+      VAST_STUDENT_GPU_QUERY: ${{ vars.VAST_STUDENT_GPU_QUERY }}
+      VAST_STUDENT_MAX_DPH: ${{ vars.VAST_STUDENT_MAX_DPH }}
+      VAST_STUDENT_DISK_GB: ${{ vars.VAST_STUDENT_DISK_GB }}
+      RUNPOD_TEACHER_GPU_IDS: ${{ vars.RUNPOD_TEACHER_GPU_IDS }}
+      RUNPOD_TEACHER_MAX_DPH: ${{ vars.RUNPOD_TEACHER_MAX_DPH }}
+      RUNPOD_STUDENT_GPU_IDS: ${{ vars.RUNPOD_STUDENT_GPU_IDS }}
+      RUNPOD_STUDENT_MAX_DPH: ${{ vars.RUNPOD_STUDENT_MAX_DPH }}
+      RUNPOD_CLOUD_TYPE: ${{ vars.RUNPOD_CLOUD_TYPE }}
+    steps:
+      - uses: actions/checkout@v6
+      - uses: actions/setup-python@v6
+        with:
+          python-version: "3.11"
+      - name: Install router dependencies
+        run: |
+          pip install -r infra/cost_router/requirements.txt
+          pip install -r infra/historical_router/requirements.txt
+          pip install -r infra/contextual_router/requirements.txt
+          pip install -r infra/residual_calibration/requirements.txt
+          pip install -r infra/conformal_router/requirements.txt
+          pip install -r infra/bandit_router/requirements.txt
+          pip install -r infra/budget_router/requirements.txt
+          pip install --upgrade vastai
+      - name: Route under per-job budget
+        id: route
+        env:
+          PYTHONPATH: infra/budget_router:infra/bandit_router:infra/historical_router:infra/contextual_router:infra/residual_calibration:infra/conformal_router
+        run: |
+          spec='${{ inputs.job_spec_path }}'
+          workload="$(jq -r '.workload' "$spec")"
+          job_id="$(jq -r '.job_id' "$spec")"
+          hf_bucket="$(jq -r '.hf_bucket' "$spec")"
+          python infra/budget_router/select_budget.py \
+            --workload "$workload" \
+            --units '${{ inputs.units }}' \
+            --job-id "$job_id" \
+            --job-spec "$spec" \
+            --bucket "$hf_bucket" \
+            --prediction-source '${{ inputs.prediction_source }}' \
+            --bandit-mode '${{ inputs.bandit_mode }}' > budget-decision.json
+          jq . budget-decision.json
+          echo "job_id=$job_id" >> "$GITHUB_OUTPUT"
+          echo "workload=$workload" >> "$GITHUB_OUTPUT"
+          echo "hf_bucket=$hf_bucket" >> "$GITHUB_OUTPUT"
+          echo "provider=$(jq -r '.selected.provider' budget-decision.json)" >> "$GITHUB_OUTPUT"
+          echo "gpu_id=$(jq -r '.selected.gpu_id // empty' budget-decision.json)" >> "$GITHUB_OUTPUT"
+          echo "offer_id=$(jq -r '.selected.offer_id // empty' budget-decision.json)" >> "$GITHUB_OUTPUT"
+          echo "price=$(jq -r '.selected.price_usd_per_hour' budget-decision.json)" >> "$GITHUB_OUTPUT"
+          echo "reserve_amount=$(jq -r '.selected.budget_upper_cost_usd // .selected.budget_expected_cost_usd' budget-decision.json)" >> "$GITHUB_OUTPUT"
+          echo "image=$(jq -r '.image' "$spec")" >> "$GITHUB_OUTPUT"
+          echo "command=$(jq -r '.command' "$spec")" >> "$GITHUB_OUTPUT"
+          echo "hf_namespace=$(jq -r '.hf_namespace // empty' "$spec")" >> "$GITHUB_OUTPUT"
+
+  reserve:
+    needs: route
+    runs-on: ubuntu-latest
+    concurrency:
+      group: budget-ledger-${{ needs.route.outputs.hf_bucket }}
+      cancel-in-progress: false
+    env:
+      HF_TOKEN: ${{ secrets.HF_TOKEN }}
+      HF_BUCKET: ${{ needs.route.outputs.hf_bucket }}
+      GPU_BUDGET_GLOBAL_DAILY_USD: ${{ vars.GPU_BUDGET_GLOBAL_DAILY_USD }}
+      GPU_BUDGET_GLOBAL_WEEKLY_USD: ${{ vars.GPU_BUDGET_GLOBAL_WEEKLY_USD }}
+      GPU_BUDGET_GLOBAL_MONTHLY_USD: ${{ vars.GPU_BUDGET_GLOBAL_MONTHLY_USD }}
+      GPU_BUDGET_TEACHER_DAILY_USD: ${{ vars.GPU_BUDGET_TEACHER_DAILY_USD }}
+      GPU_BUDGET_TEACHER_WEEKLY_USD: ${{ vars.GPU_BUDGET_TEACHER_WEEKLY_USD }}
+      GPU_BUDGET_TEACHER_MONTHLY_USD: ${{ vars.GPU_BUDGET_TEACHER_MONTHLY_USD }}
+      GPU_BUDGET_STUDENT_DAILY_USD: ${{ vars.GPU_BUDGET_STUDENT_DAILY_USD }}
+      GPU_BUDGET_STUDENT_WEEKLY_USD: ${{ vars.GPU_BUDGET_STUDENT_WEEKLY_USD }}
+      GPU_BUDGET_STUDENT_MONTHLY_USD: ${{ vars.GPU_BUDGET_STUDENT_MONTHLY_USD }}
+    steps:
+      - uses: actions/checkout@v6
+      - uses: actions/setup-python@v6
+        with:
+          python-version: "3.11"
+      - run: pip install -r infra/budget_ledger/requirements.txt
+      - env:
+          PYTHONPATH: infra/budget_ledger
+        run: |
+          python infra/budget_ledger/reserve.py \
+            --bucket "$HF_BUCKET" \
+            --job-id '${{ needs.route.outputs.job_id }}' \
+            --workload '${{ needs.route.outputs.workload }}' \
+            --amount-usd '${{ needs.route.outputs.reserve_amount }}' \
+            --provider '${{ needs.route.outputs.provider }}' \
+            --gpu-id '${{ needs.route.outputs.gpu_id }}'
+
+  launch:
+    needs: [route, reserve]
+    runs-on: ubuntu-latest
+    environment: gpu-auto
+    outputs:
+      resource_id: ${{ steps.launch.outputs.resource_id }}
+      launched_at: ${{ steps.launch.outputs.launched_at }}
+    env:
+      HF_TOKEN: ${{ secrets.HF_TOKEN }}
+      HF_BUCKET: ${{ needs.route.outputs.hf_bucket }}
+      HF_NAMESPACE: ${{ needs.route.outputs.hf_namespace }}
+      VAST_API_KEY: ${{ secrets.VAST_API_KEY }}
+      RUNPOD_API_KEY: ${{ secrets.RUNPOD_API_KEY }}
+      RUNPOD_REGISTRY_AUTH_ID: ${{ vars.RUNPOD_REGISTRY_AUTH_ID }}
+      RUNPOD_CLOUD_TYPE: ${{ vars.RUNPOD_CLOUD_TYPE || 'SECURE' }}
+      RUN_ID: ${{ needs.route.outputs.job_id }}
+      IMAGE_REF: ${{ needs.route.outputs.image }}
+    steps:
+      - uses: actions/checkout@v6
+      - uses: actions/setup-python@v6
+        with:
+          python-version: "3.11"
+      - run: pip install --upgrade vastai
+      - name: Load runtime environment
+        run: |
+          spec='${{ inputs.job_spec_path }}'
+          for key in JOB_KIND AUDIO_REL SEGMENTS_REL TRAIN_REL VALID_REL EPOCHS PARAKEET_MODEL STEPAUDIO_MODEL; do
+            value="$(jq -r --arg key "$key" '.runtime_env[$key] // empty' "$spec")"
+            [ -z "$value" ] || echo "$key=$value" >> "$GITHUB_ENV"
+          done
+          if [ -z "${JOB_KIND:-}" ]; then
+            echo "JOB_KIND=$(jq -r '.workload' "$spec")" >> "$GITHUB_ENV"
+          fi
+      - name: Launch
+        id: launch
+        env:
+          SELECTED_PROVIDER: ${{ needs.route.outputs.provider }}
+          SELECTED_GPU: ${{ needs.route.outputs.gpu_id }}
+          VAST_OFFER_ID: ${{ needs.route.outputs.offer_id }}
+          HF_JOB_IMAGE: ${{ needs.route.outputs.image }}
+          HF_JOB_COMMAND: ${{ needs.route.outputs.command }}
+        run: |
+          echo "launched_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$GITHUB_OUTPUT"
+          case "$SELECTED_PROVIDER" in
+            vast) resource_id="$(VAST_OFFER_ID="$VAST_OFFER_ID" bash infra/vast/create_job.sh)" ;;
+            runpod)
+              args=(--image "$IMAGE_REF" --name "$RUN_ID" --cloud-type "$RUNPOD_CLOUD_TYPE" --gpu "$SELECTED_GPU" --container-disk 100 --volume 0)
+              [ -z "${RUNPOD_REGISTRY_AUTH_ID:-}" ] || args+=(--registry-auth-id "$RUNPOD_REGISTRY_AUTH_ID")
+              resource_id="$(python infra/runpod/create_job.py "${args[@]}")" ;;
+            hf_jobs) resource_id="$(bash infra/hf/run_generic_job.sh)" ;;
+            *) echo "Unsupported provider $SELECTED_PROVIDER" >&2; exit 2 ;;
+          esac
+          echo "resource_id=$resource_id" >> "$GITHUB_OUTPUT"
+
+  release-on-launch-failure:
+    needs: [route, reserve, launch]
+    if: ${{ always() && needs.reserve.result == 'success' && needs.launch.result == 'failure' }}
+    runs-on: ubuntu-latest
+    concurrency:
+      group: budget-ledger-${{ needs.route.outputs.hf_bucket }}
+      cancel-in-progress: false
+    env:
+      HF_TOKEN: ${{ secrets.HF_TOKEN }}
+      HF_BUCKET: ${{ needs.route.outputs.hf_bucket }}
+    steps:
+      - uses: actions/checkout@v6
+      - uses: actions/setup-python@v6
+        with:
+          python-version: "3.11"
+      - run: pip install -r infra/budget_ledger/requirements.txt
+      - env:
+          PYTHONPATH: infra/budget_ledger
+        run: |
+          python infra/budget_ledger/release.py \
+            --bucket "$HF_BUCKET" \
+            --job-id '${{ needs.route.outputs.job_id }}' \
+            --reason launch_failed
+
+  monitor:
+    needs: [route, reserve, launch]
+    runs-on: ubuntu-latest
+    timeout-minutes: 360
+    env:
+      HF_TOKEN: ${{ secrets.HF_TOKEN }}
+      HF_BUCKET: ${{ needs.route.outputs.hf_bucket }}
+      VAST_API_KEY: ${{ secrets.VAST_API_KEY }}
+      RUNPOD_API_KEY: ${{ secrets.RUNPOD_API_KEY }}
+    steps:
+      - uses: actions/checkout@v6
+      - uses: actions/setup-python@v6
+        with:
+          python-version: "3.11"
+      - run: |
+          pip install -r infra/unified_job/requirements.txt
+          pip install --upgrade vastai
+      - name: Monitor/account/cleanup
+        env:
+          PYTHONPATH: infra/unified_job
+        run: |
+          python infra/unified_job/watch_and_account.py \
+            --job-spec '${{ inputs.job_spec_path }}' \
+            --provider '${{ needs.route.outputs.provider }}' \
+            --resource-id '${{ needs.launch.outputs.resource_id }}' \
+            --quoted-price '${{ needs.route.outputs.price }}' \
+            --launched-at '${{ needs.launch.outputs.launched_at }}' \
+            --namespace '${{ needs.route.outputs.hf_namespace }}'
+
+  settle-or-release:
+    needs: [route, reserve, launch, monitor]
+    if: ${{ always() && needs.reserve.result == 'success' && needs.launch.result == 'success' }}
+    runs-on: ubuntu-latest
+    concurrency:
+      group: budget-ledger-${{ needs.route.outputs.hf_bucket }}
+      cancel-in-progress: false
+    env:
+      HF_TOKEN: ${{ secrets.HF_TOKEN }}
+      HF_BUCKET: ${{ needs.route.outputs.hf_bucket }}
+    steps:
+      - uses: actions/checkout@v6
+      - uses: actions/setup-python@v6
+        with:
+          python-version: "3.11"
+      - run: pip install -r infra/budget_ledger/requirements.txt
+      - name: Settle from cost record, otherwise release
+        env:
+          PYTHONPATH: infra/budget_ledger
+        run: |
+          if python - <<'PY2'
+          import os
+          from huggingface_hub import HfFileSystem
+          fs = HfFileSystem(token=os.environ.get("HF_TOKEN"))
+          path = "hf://buckets/${{ needs.route.outputs.hf_bucket }}/runs/${{ needs.route.outputs.job_id }}/cost.json"
+          raise SystemExit(0 if fs.exists(path) else 1)
+          PY2
+          then
+            python infra/budget_ledger/settle.py \
+              --bucket "$HF_BUCKET" \
+              --job-id '${{ needs.route.outputs.job_id }}'
+          else
+            python infra/budget_ledger/release.py \
+              --bucket "$HF_BUCKET" \
+              --job-id '${{ needs.route.outputs.job_id }}' \
+              --reason no_cost_record
+          fi
