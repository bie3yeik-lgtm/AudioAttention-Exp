{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/audio-editorial/job-spec.schema.json",
  "title": "Audio Editorial Unified Job Spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "workload",
    "image",
    "command",
    "hf_bucket"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "workload": {
      "type": "string",
      "enum": [
        "preprocess",
        "validate",
        "golden-cpu",
        "teacher",
        "student",
        "golden-gpu"
      ]
    },
    "image": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "hf_bucket": {
      "type": "string",
      "minLength": 1
    },
    "hf_namespace": {
      "type": [
        "string",
        "null"
      ]
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 60,
      "default": 14400
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_audio_hours": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "epochs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "samples": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "runtime_env": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean"
        ]
      },
      "description": "Environment variables passed to provider runtime."
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "audio_duration_hours": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "sample_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "dataset_size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "batch_size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "sequence_length": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "model_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "prompt_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "dataset_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "cache_state": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "cold",
            "warm",
            "mixed",
            null
          ]
        },
        "precision": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "fp32",
            "tf32",
            "fp16",
            "bf16",
            "int8",
            "int4",
            "mixed",
            null
          ]
        },
        "gpu_architecture": {
          "type": [
            "string",
            "null"
          ]
        },
        "framework_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "container_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "feature_schema_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "teacher_prompt_tokens_estimate": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "budget": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "unbounded",
            "soft_budget",
            "hard_budget"
          ]
        },
        "max_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "target_confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0.5,
          "maximum": 0.999
        },
        "soft_penalty_multiplier": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  }
}
